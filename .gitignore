# ==============================================================================
# ZeroBots - Official .gitignore
# ==============================================================================

# 1. Dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 2. Next.js Build Outputs & Cache
.next/
out/
build/
dist/
.turbo/

# 3. Environment Variables (never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env

# Keep example / template environment files tracked
!.env.example
!.env.template
.env*.example

# 4. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# 5. TypeScript & Compilation Cache
*.tsbuildinfo
tsconfig.tsbuildinfo
next-env.d.ts

# 6. Testing & Coverage
coverage/
.nyc_output/

# 7. Vercel & Cloud Deployments
.vercel/

# 8. Operating System Artifacts
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# 9. IDE & Editor Configs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# 10. Temporary & Scratch
tmp/
temp/
.cache/
.vinext/
.cloudflare/
